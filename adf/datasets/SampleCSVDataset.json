{
  "name": "SampleCSVDataset",
  "type": "Microsoft.DataFactory/factories/datasets",
  "apiVersion": "2018-06-01",
  "properties": {
    "linkedServiceName": {
      "referenceName": "AzureDataLakeStorageGen2",
      "type": "LinkedServiceReference"
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "input",
        "folderPath": "data",
        "fileName": "sample.csv"
      },
      "columnDelimiter": ",",
      "escapeChar": "\\",
      "quoteChar": "\""
    },
    "schema": [
      {
        "name": "Column1",
        "type": "String"
      },
      {
        "name": "Column2",
        "type": "String"
      },
      {
        "name": "Column3",
        "type": "String"
      }
    ]
  }
}
