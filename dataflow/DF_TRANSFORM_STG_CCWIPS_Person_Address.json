{
	"name": "DF_TRANSFORM_STG_CCWIPS_Person_Address",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_LND_CCWIPS_PROVIDER_ADDRESS",
						"type": "DatasetReference"
					},
					"name": "dsLndCcwipsProviderAddress"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_STG_CCWIPS_PROVIDER_ADDRESS",
						"type": "DatasetReference"
					},
					"name": "SNKSTGPROVIDERADDRESS"
				}
			],
			"transformations": [
				{
					"name": "DRVCLEANSED"
				},
				{
					"name": "WINDEDUP"
				},
				{
					"name": "FILVALID"
				},
				{
					"name": "ARUPSERT"
				}
			],
			"scriptLines": [
				"parameters{",
				"     srcSchema as string ('LANDING'),",
				"     srcTable as string ('CCWIPS_PROVIDER_ADDRESS'),",
				"     tgtSchema as string ('STAGING'),",
				"     tgtTable as string ('CCWIPS_PROVIDER_ADDRESS')",
				"}",
				"source(output(",
				"          CCWIPS_PROVIDER_ADDRESS_ID as long,",
				"          CCWIPS_PROVIDER_ID as long,",
				"          ADDR_TYPE_CD as string,",
				"          PRMRY_IND as string,",
				"          ADDR_STS_CD as string,",
				"          STR_NBR as string,",
				"          STR_NM as string,",
				"          APT_NBR as string,",
				"          CITY_NM as string,",
				"          ST_CD as string,",
				"          ZIP_CD as string,",
				"          ZIP_EXT as string,",
				"          CNTY_CD as string,",
				"          CNTRY_CD as string,",
				"          LAT_VAL as decimal(10,6),",
				"          LONG_VAL as decimal(11,6),",
				"          EFF_START_DT as date,",
				"          EFF_END_DT as date,",
				"          REC_STS_CD as string,",
				"          CRT_TS as timestamp,",
				"          UPD_TS as timestamp,",
				"          CRT_USER_ID as string,",
				"          UPD_USER_ID as string,",
				"          LOAD_BATCH_ID as long,",
				"          LOAD_DATE as timestamp,",
				"          SOURCE_FILE_NAME as string,",
				"          ROW_HASH as binary",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dsLndCcwipsProviderAddress",
				"dsLndCcwipsProviderAddress derive(CCWIPS_PROVIDER_ADDRESS_ID = toLong(trim(toString(CCWIPS_PROVIDER_ADDRESS_ID))),",
				"          CCWIPS_PROVIDER_ID = toLong(trim(toString(CCWIPS_PROVIDER_ID))),",
				"          ADDR_TYPE_CD = upper(trim(toString(ADDR_TYPE_CD))),",
				"          PRMRY_IND = upper(trim(toString(PRMRY_IND))),",
				"          ADDR_STS_CD = upper(trim(toString(ADDR_STS_CD)))) ~> DRVCLEANSED",
				"DRVCLEANSED window(over(CCWIPS_PROVIDER_ADDRESS_ID),",
				"     asc(CCWIPS_PROVIDER_ID, true),",
				"     rn = rowNumber()) ~> WINDEDUP",
				"WINDEDUP filter(rn == 1 &&",
				"    !isNull(CCWIPS_PROVIDER_ADDRESS_ID) &&",
				"    !isNull(CCWIPS_PROVIDER_ID) &&",
				"    (ADDR_TYPE_CD == 'PH' || ADDR_TYPE_CD == 'ML') &&",
				"    (PRMRY_IND == 'Y' || PRMRY_IND == 'N') &&",
				"    (ADDR_STS_CD == 'A' || ADDR_STS_CD == 'I') &&",
				"    (REC_STS_CD == 'A' || REC_STS_CD == 'I') &&",
				"    (isNull(EFF_END_DT) || isNull(EFF_START_DT) || EFF_END_DT >= EFF_START_DT) &&",
				"    (ADDR_TYPE_CD != 'PH' || (!isNull(STR_NM) && !isNull(CITY_NM) && !isNull(ST_CD) && !isNull(ZIP_CD)))) ~> FILVALID",
				"FILVALID alterRow(upsertIf(true())) ~> ARUPSERT",
				"ARUPSERT sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          CCWIPS_PROVIDER_ADDRESS_ID as long,",
				"          CCWIPS_PROVIDER_ID as long,",
				"          ADDR_TYPE_CD as string,",
				"          PRMRY_IND as string,",
				"          ADDR_STS_CD as string,",
				"          STR_NBR as string,",
				"          STR_NM as string,",
				"          APT_NBR as string,",
				"          CITY_NM as string,",
				"          ST_CD as string,",
				"          ZIP_CD as string,",
				"          ZIP_EXT as string,",
				"          CNTY_CD as string,",
				"          CNTRY_CD as string,",
				"          LAT_VAL as decimal(10,6),",
				"          LONG_VAL as decimal(11,6),",
				"          EFF_START_DT as date,",
				"          EFF_END_DT as date,",
				"          REC_STS_CD as string,",
				"          CRT_TS as timestamp,",
				"          UPD_TS as timestamp,",
				"          CRT_USER_ID as string,",
				"          UPD_USER_ID as string,",
				"          LOAD_BATCH_ID as long,",
				"          LOAD_DATE as timestamp,",
				"          SOURCE_FILE_NAME as string,",
				"          ROW_HASH as binary",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:true,",
				"     keys:['CCWIPS_PROVIDER_ADDRESS_ID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          CCWIPS_PROVIDER_ADDRESS_ID,",
				"          CCWIPS_PROVIDER_ID,",
				"          ADDR_TYPE_CD,",
				"          PRMRY_IND,",
				"          ADDR_STS_CD,",
				"          STR_NBR,",
				"          STR_NM,",
				"          APT_NBR,",
				"          CITY_NM,",
				"          ST_CD,",
				"          ZIP_CD,",
				"          ZIP_EXT,",
				"          CNTY_CD,",
				"          CNTRY_CD,",
				"          LAT_VAL,",
				"          LONG_VAL,",
				"          EFF_START_DT,",
				"          EFF_END_DT,",
				"          REC_STS_CD,",
				"          CRT_TS,",
				"          UPD_TS,",
				"          CRT_USER_ID,",
				"          UPD_USER_ID,",
				"          LOAD_BATCH_ID,",
				"          LOAD_DATE,",
				"          SOURCE_FILE_NAME,",
				"          ROW_HASH",
				"     )) ~> SNKSTGPROVIDERADDRESS"
			]
		}
	}
}