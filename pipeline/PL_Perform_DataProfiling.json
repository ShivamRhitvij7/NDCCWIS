{
	"name": "PL_Perform_DataProfiling",
	"properties": {
		"description": "Data Profiling Framework: Validates FRAME_PERSON, FRAME_CASE, FRAME_CASE_PARTICIPANT tables through 10 profiling rules, cleanses fixable records, re-validates, and generates summary report.",
		"activities": [
			{
				"name": "Step1_InitProfilingRun",
				"description": "Initialize RunID and set all GOLDEN_RECORD_FLAG to I (Initialize)",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Step0_LookupRunID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[STAGING].[SP_InitProfilingRun]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "String"
						},
						"RunID": {
							"value": {
								"value": "@activity('Step0_LookupRunID').output.firstRow.RunID\r\n",
								"type": "Expression"
							},
							"type": "Int16"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_COVNERSION_SQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Step2_ExecuteProfilingChecks",
				"description": "Run all 5 profiling rules and log exceptions to EXCEPTION_LOG",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Step1_InitProfilingRun",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[STAGING].[SP_ExecuteProfilingChecks]",
					"storedProcedureParameters": {
						"RunID": {
							"value": {
								"value": "@activity('Step0_LookupRunID').output.firstRow.RunID",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_COVNERSION_SQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Step0_LookupRunID",
				"description": "Retrieve the RunID generated by the init procedure",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT ISNULL(MAX(RUN_ID), 10001) AS RunID FROM [STAGING].[PROFILING_RUN_LOG];",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_LND_FRAME_CASE_SQL",
						"type": "DatasetReference"
					}
				}
			}
		],
		"parameters": {
			"SourceSystem": {
				"type": "string",
				"defaultValue": "FRAME_LEGACY"
			},
			"RunID": {
				"type": "string",
				"defaultValue": "10001"
			}
		},
		"folder": {
			"name": "2. LND_TO_STG"
		},
		"annotations": []
	}
}