{
	"name": "PL_DataProfiling_Framework",
	"properties": {
		"description": "Data Profiling Framework: Validates FRAME_PERSON, FRAME_CASE, FRAME_CASE_PARTICIPANT tables through 10 profiling rules, cleanses fixable records, re-validates, and generates summary report.",
		"activities": [
			{
				"name": "Step1_InitProfilingRun",
				"description": "Initialize RunID and set all GOLDEN_RECORD_FLAG to P (default pass)",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[STAGING].[SP_InitProfilingRun]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "String"
						},
						"RunID": {
							"value": {
								"value": "@pipeline().parameters.RunID",
								"type": "Expression"
							},
							"type": "Int16"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_COVNERSION_SQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Step1b_LookupRunID",
				"description": "Retrieve the RunID generated by the init procedure",
				"type": "Lookup",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Step1_InitProfilingRun",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 1,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT ISNULL(MAX(RUN_ID), 0) AS RunID FROM [STAGING].[PROFILING_RUN_LOG];",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_STG_FRAME_PERSON",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				},
				"linkedServiceName": {
					"referenceName": "<your-linked-service-name>",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Step2_ExecuteProfilingChecks",
				"description": "Run all 10 profiling rules and log exceptions to EXCEPTION_LOG",
				"type": "SqlServerStoredProcedure",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Step1b_LookupRunID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[STAGING].[SP_ExecuteProfilingChecks]",
					"storedProcedureParameters": {
						"RunID": {
							"value": {
								"value": "@activity('Step1b_LookupRunID').output.firstRow.RunID",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_COVNERSION_SQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Step3_ApplyCleansingLogic",
				"description": "Auto-remediate fixable records; quarantine unfixable ones",
				"type": "SqlServerStoredProcedure",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Step2_ExecuteProfilingChecks",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[STAGING].[SP_ApplyCleansingLogic]",
					"storedProcedureParameters": {
						"RunID": {
							"value": {
								"value": "@activity('Step1b_LookupRunID').output.firstRow.RunID",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_COVNERSION_SQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Step4_RerunProfilingCleansed",
				"description": "Re-validate cleansed records; promote passing ones, quarantine failures",
				"type": "SqlServerStoredProcedure",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Step3_ApplyCleansingLogic",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[STAGING].[SP_RerunProfilingCleansed]",
					"storedProcedureParameters": {
						"RunID": {
							"value": {
								"value": "@activity('Step1b_LookupRunID').output.firstRow.RunID",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_COVNERSION_SQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Step5_GenerateSummaryReport",
				"description": "Finalize run log with counts and pass/quarantine rates",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Step4_RerunProfilingCleansed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[STAGING].[SP_GenerateSummaryReport]",
					"storedProcedureParameters": {
						"RunID": {
							"value": {
								"value": "@activity('Step1b_LookupRunID').output.firstRow.RunID",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_COVNERSION_SQL",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"SourceSystem": {
				"type": "string",
				"defaultValue": "FRAME_LEGACY"
			},
			"RunID": {
				"type": "int",
				"defaultValue": 10001
			}
		},
		"annotations": [
			"DataProfiling",
			"DataQuality",
			"CCWIS",
			"FRAME"
		],
		"lastPublishTime": "2025-01-01T00:00:00Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}