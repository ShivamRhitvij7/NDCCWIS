{
	"name": "PL_CONV_xg_case_To_DYN_xg_case",
	"properties": {
		"description": "Pipeline to copy data from Conversion Schema Case table to Dynamics case table",
		"activities": [
			{
				"name": "PL_Case_Load",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\r\n     NEWID() as xg_caseid,\r\n     NEWID() as xgi_caseid,\r\n    xg_externalid,\r\n    xg_casetype,\r\n    statuscode,\r\n    xg_caseopendate,\r\n    xg_caseclosedate,\r\n    xg_closurereason,\r\n    overriddencreatedon,\r\n    xgi_overridemodifieddate,\r\n    OwnerId,\r\n    OwnerIdType\r\nFROM[CONVERSION].[xg_case]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "CommonDataServiceForAppsSink",
						"writeBatchSize": 10,
						"writeBehavior": "upsert"
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "overriddencreatedon",
									"type": "DateTime",
									"physicalType": "datetime2"
								},
								"sink": {
									"name": "overriddencreatedon",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"name": "OwnerId",
									"type": "Guid",
									"physicalType": "uniqueidentifier"
								},
								"sink": {
									"name": "ownerid",
									"type": "Guid"
								}
							},
							{
								"source": {
									"name": "OwnerIdType",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "ownerid@EntityReference"
								}
							},
							{
								"source": {
									"name": "xg_caseid",
									"type": "Guid",
									"physicalType": "uniqueidentifier"
								},
								"sink": {
									"name": "xg_caseid",
									"type": "Guid"
								}
							},
							{
								"source": {
									"name": "xg_caseopendate",
									"type": "DateTime",
									"physicalType": "datetime2"
								},
								"sink": {
									"name": "xg_caseopendate",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"name": "xg_casetype",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "xg_casetype",
									"type": "Int32"
								}
							},
							{
								"source": {
									"name": "xg_externalid",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "xg_externalid",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "xgi_caseid",
									"type": "Guid",
									"physicalType": "uniqueidentifier"
								},
								"sink": {
									"name": "xgi_caseid",
									"type": "Guid"
								}
							},
							{
								"source": {
									"name": "xgi_overridemodifieddate",
									"type": "DateTime",
									"physicalType": "datetime2"
								},
								"sink": {
									"name": "xgi_overridemodifieddate",
									"type": "DateTime"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_CONV_CASE",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_DATAVS_CASE",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "4. CONV_TO_DYNAMICS"
		},
		"annotations": []
	}
}