{
  "name": "AzureDataLakeStorageGen2",
  "type": "Microsoft.DataFactory/factories/linkedservices",
  "apiVersion": "2018-06-01",
  "properties": {
    "type": "AzureBlobFS",
    "typeProperties": {
      "url": "@{linkedService().storageAccountUrl}",
      "accountKey": {
        "type": "SecureString",
        "value": "@{linkedService().storageAccountKey}"
      }
    }
  }
}
